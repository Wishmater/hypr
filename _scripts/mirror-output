#!/usr/bin/env nu

use std/log
use std null-device

def main [output_to_mirror?: string] {
    let target = if ($output_to_mirror | is-empty) {
        (^hyprctl activeworkspace -j | from json).monitor
    } else {
        $output_to_mirror
    }

    let allNames = (^hyprctl monitors -j | from json | get name)

    if $target not-in $allNames {
        log error $"Output '($target)' not found."
        log info $"Available: ($allNames | str join ' ')"
        exit 1
    }

    if ($allNames | length) <= 1 {
        log info "Only one monitor connected -- nothing to mirror."
        exit 0
    }

    log info $"Mirroring output: ($target)"

    for output in $allNames {
        if $output != $target {
            log info $"  Creating mirror on: ($output)"

            ^hyprctl dispatch ("hl.dsp.focus({ monitor = '" + $output + "' })") out> (null-device)

            job spawn { ^wl-mirror -s c $target }

            sleep 200ms

            let mirrorWindows = (^hyprctl clients -j | from json | where class == "at.yrlf.wl_mirror")

            if ($mirrorWindows | length) > 0 {
                let address = ($mirrorWindows | last).address
                log info $"    window: ($address)"

                ^hyprctl dispatch ("hl.dsp.focus({ window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.window.tag({ tag = 'crsmntr_pinned', window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.focus({ window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.window.move({ monitor = '" + $output + "', window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.focus({ window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.window.fullscreen({ action = 'set', window = 'address:" + $address + "' })") out> (null-device)
                ^hyprctl dispatch ("hl.dsp.focus({ monitor = '" + $target + "' })") out> (null-device)
            } else {
                log warning $"    could not find wl-mirror window for ($output)"
            }
        }
    }

    log info "Done. Press Enter to stop all mirrors..."
    input

    log info "Stopping mirror processes..."
    ^pkill wl-mirror
    log info "Done."
}
