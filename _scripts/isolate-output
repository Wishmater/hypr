#!/usr/bin/env nu

use std/log
use std null-device

def main [output?: string] {
    let target = if ($output | is-empty) {
        (^hyprctl activeworkspace -j | from json).monitor
    } else {
        $output
    }

    let names = (^hyprctl monitors -j | from json | get name)

    if $target not-in $names {
        log error $"Output '($target)' not found."
        log info $"Available: ($names | str join ' ')"
        exit 1
    }

    if ($names | length) <= 1 {
        log info "Only one monitor connected -- nothing to isolate."
        exit 0
    }

    let keyDpmsOpt = (^hyprctl getoption misc:key_press_enables_dpms -j | from json)
    let mouseDpmsOpt = (^hyprctl getoption misc:mouse_move_enables_dpms -j | from json)
    let keyDpmsWas = if "int" in ($keyDpmsOpt | columns) { $keyDpmsOpt.int != 0 } else { $keyDpmsOpt.bool }
    let mouseDpmsWas = if "int" in ($mouseDpmsOpt | columns) { $mouseDpmsOpt.int != 0 } else { $mouseDpmsOpt.bool }

    ^hyprctl eval "hl.config({ misc = { key_press_enables_dpms = false, mouse_move_enables_dpms = false } })" out> (null-device)

    log info $"Isolating output: ($target)"

    for mon in $names {
        if $mon != $target {
            log info $"  DPMS off: ($mon)"
            ^hyprctl dispatch ("hl.dsp.dpms({ action = 'off', monitor = '" + $mon + "' })") out> (null-device)
        }
    }

    log info $"Output '($target)' is now isolated."
    print "Press Enter to restore all outputs..."
    input

    log info "Restoring all outputs..."

    ^hyprctl eval ("hl.config({ misc = { key_press_enables_dpms = " + (if $keyDpmsWas { "true" } else { "false" }) + ", mouse_move_enables_dpms = " + (if $mouseDpmsWas { "true" } else { "false" }) + " } })") out> (null-device)

    for mon in $names {
        if $mon != $target {
            log info $"  DPMS on: ($mon)"
            ^hyprctl dispatch ("hl.dsp.dpms({ action = 'on', monitor = '" + $mon + "' })") out> (null-device)
        }
    }

    log info "Done."
}
