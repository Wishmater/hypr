#!/usr/bin/env nu

use std/log
use std null-device

def main [output?: string] {
    let target = if ($output | is-empty) {
        (^hyprctl activeworkspace -j | from json).monitor
    } else {
        $output
    }

    let names = (^hyprctl monitors -j | from json | get name)

    if $target not-in $names {
        log error $"Output '($target)' not found."
        log info $"Available: ($names | str join ' ')"
        exit 1
    }

    if ($names | length) <= 1 {
        log info "Only one monitor connected -- nothing to isolate."
        exit 0
    }

    log info $"Isolating output: ($target)"

    for mon in $names {
        if $mon != $target {
            log info $"  Disabling ($mon)"
            ^hyprctl eval ("hl.monitor({ output = '" + $mon + "', disabled = true })") out> (null-device)
        }
    }

    log info $"Output '($target)' is now isolated."
    print "Press Enter to restore all outputs..."
    input

    log info "Restoring all outputs..."

    for mon in $names {
        if $mon != $target {
            log info $"  Enabling ($mon)"
            ^hyprctl eval ("hl.monitor({ output = '" + $mon + "', disabled = false })") out> (null-device)
        }
    }

    log info "Done."
}
